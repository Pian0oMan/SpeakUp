# Copy this file to ".env" (in the same folder as app.py) and fill in your own values.
# .env is in .gitignore, so your keys never end up on GitHub.

# Supabase: Dashboard -> your project -> Connect (or Project Settings -> Data API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=

# DeepL (translations): deepl.com -> your account -> API Keys. Free keys end in ":fx".
# Leave it empty and the app still works, just without translations.
DEEPL_API_KEY=

# Optional: a TURN server, so calls also work on strict networks (see README.md).
# Several addresses can be listed, separated by commas.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
